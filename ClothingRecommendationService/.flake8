[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    interfaces,
    .venv,
    venv
per-file-ignores =
    # Allow long HTML strings in demo page
    src/api/main.py:E501
    # Allow slightly long Pydantic field lines for clarity
    src/api/models.py:E501
    # Allow a couple of long lines in synthesized tips and normalization logic
    src/api/services.py:E501
